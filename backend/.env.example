# Places Project/backend/.env.example
# ✅ THIS FILE IS COMMITTED TO GIT (SAFE TO SHARE)

# Database connection (replace with your actual credentials)
DATABASE_URL=postgresql+psycopg://postgres:your_password_here@localhost:5432/your_database_name

# Secret key for signing sessions (generate your own)
SECRET_KEY=your-secret-key-here-change-me

# Application settings
DEBUG=True
APP_NAME=My FastAPI App

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30